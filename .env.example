LAB_DB_PATH=./data/lab.db
LAB_PORT=8788
LAB_SEED_CLASS_NAME=2026-高一信息技术-01
LAB_SEED_INVITE_CODE=CLASS26
LAB_ADMIN_STUDENT_NO=admin
LAB_ADMIN_NAME=管理员
LAB_ADMIN_PASSWORD=change-me-in-production
LAB_TEACHER_STUDENT_NO=teacher
LAB_TEACHER_NAME=教师
LAB_TEACHER_PASSWORD=change-me-in-production
# Force the Secure flag on the session cookie when terminating TLS upstream
# (auto-detected via https / x-forwarded-proto; set to 1 only if detection fails)
LAB_SECURE_COOKIES=0
# Set to 1 only when a trusted reverse proxy (e.g. the Caddy site in deploy/)
# fronts the app — enables honoring X-Forwarded-Proto/For for Secure-cookie
# detection and login rate-limit keys. Without it those headers are ignored
# because any direct client can spoof them.
LAB_TRUST_PROXY=0
