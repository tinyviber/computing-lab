{
  "name": "computing-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "scripts": {
    "setup": "bun install",
    "dev": "bun run vite",
    "build": "bun run typecheck && bun run vite build",
    "test": "bun run vitest --passWithNoTests",
    "test:run": "bun run vitest run --passWithNoTests",
    "test:deploy": "bash deploy/tests/reconcile.test.sh",
    "test:e2e": "bun run build && playwright test",
    "deploy": "bash deploy/reconcile.sh reconcile",
    "test:caddy": "bash deploy/tests/caddy.test.sh",
    "deploy:rollback": "bash deploy/reconcile.sh rollback",
    "deploy:status": "bash deploy/reconcile.sh status",
    "lint": "bun run eslint .",
    "typecheck": "bun run tsc --noEmit",
    "format:check": "bun run prettier --check .",
    "format": "bun run prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
