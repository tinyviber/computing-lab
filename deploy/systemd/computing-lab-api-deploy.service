[Unit]
Description=Computing Lab API source deploy (pull + restart + health gate)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=API_DEPLOY_CONFIG=/etc/computing-lab/api-deploy.env
Environment=API_DEPLOY_TEST_MODE=0
ExecStart=/usr/local/libexec/computing-lab-api/api-deploy.sh deploy
TimeoutStartSec=10min
