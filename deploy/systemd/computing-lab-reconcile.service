[Unit]
Description=Computing Lab static release reconciliation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=computing-lab
Group=computing-lab
Environment=DEPLOY_CONFIG=/etc/computing-lab/deploy.env
Environment=DEPLOY_TEST_MODE=0
ExecStart=/usr/local/libexec/computing-lab/reconcile.sh reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/computing-lab
UMask=0027
TimeoutStartSec=15min
