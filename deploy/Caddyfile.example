# Production template: one dedicated subdomain and the root-built artifact
# (VITE_BASE_PATH=/) only. Replace placeholders in a host-managed copy.
{$SITE_ADDRESS} {
    root * {$DEPLOY_ROOT}/current/dist

    # Compress responses on the fly; .br/.gz siblings on disk (see
    # `precompressed` below) take precedence where they exist.
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
    }

    # index.html is the deploy boundary: it must revalidate on every load so a
    # new release is picked up immediately. Hashed files under /assets stay
    # cacheable. The header runs before the rewrite below, so match the
    # original extensionless path (@spa) and the direct /index.html request.
    @index path /index.html
    header @index Cache-Control "no-cache"

    # Vendored runtimes live under a versioned path (vendor/pyodide-<ver>/)
    # and are the largest payload in the app — pin them in browser caches so
    # repeat classroom sessions never re-download them.
    @vendor path /vendor/*
    header @vendor Cache-Control "public, max-age=31536000, immutable"

    @spa {
        not file
        not path /assets/* /icons/* /fonts/* /vendor/* /favicon.ico /robots.txt /manifest.webmanifest
        path_regexp extensionless ^(?:/[^./]+)*/?$
    }

    header @spa Cache-Control "no-cache"

    # Production root artifact. try_files keeps real files authoritative; only
    # extensionless, non-asset paths reach index.html, so missing JS/CSS/image
    # files remain 404.
    handle {
        route {
            try_files {path}
            rewrite @spa /index.html
            # Serve the .br/.gz siblings produced by scripts/sync-pyodide.mjs
            # instead of compressing the ~10 MB wasm per request.
            file_server {
                precompressed br gzip
            }
        }
    }
}
