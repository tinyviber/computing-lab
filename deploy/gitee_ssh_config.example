# Copy to the host-managed path from GITEE_SSH_CONFIG.
# The reconciler supplies the key, known_hosts, and safety options again on the
# command line, then verifies the effective OpenSSH configuration with ssh -G.

Host gitee.com
    HostName gitee.com
    User git
    BatchMode yes
    IdentityFile /etc/computing-lab/keys/gitee-readonly
    IdentitiesOnly yes
    UserKnownHostsFile /etc/computing-lab/known_hosts
    GlobalKnownHostsFile /dev/null
    StrictHostKeyChecking yes
    IdentityAgent none
    ControlMaster no
    ControlPath none
