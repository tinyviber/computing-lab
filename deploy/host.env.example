# Copy to a host-managed file such as /etc/computing-lab/deploy.env.
# Values below are examples only. Do not commit real credentials or addresses.

DEPLOY_ROOT=/srv/computing-lab
GITEE_REMOTE=git@gitee.com:OWNER/computing-lab.git
GITEE_REF=main
GITEE_SSH_HOST=gitee.com
GITEE_SSH_CONFIG=/etc/computing-lab/gitee_ssh_config
GITEE_SSH_KEY=/etc/computing-lab/keys/gitee-readonly
GITEE_KNOWN_HOSTS=/etc/computing-lab/known_hosts
SSH_BIN=/usr/bin/ssh
BUN_BIN=/opt/computing-lab/runtime/bun/bin/bun
PYTHON_BIN=/usr/bin/python3
FLOCK_BIN=/usr/bin/flock
VITE_BASE_PATH=/
KEEP_RELEASES=3

# The reconciler constructs and exports GIT_SSH_COMMAND from the fields above.
# Do not set or export GIT_SSH_COMMAND in this file or in the operator shell.
